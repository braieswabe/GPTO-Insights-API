NODE_ENV=production

# ── Database (Neon) ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host:5432/database?sslmode=require
DATABASE_POOL_MAX=10

# ── Auth ─────────────────────────────────────────────────────────
INTERNAL_API_TOKEN=replace-with-a-long-random-secret
CRON_SECRET=replace-with-a-long-random-secret

# ── Server ───────────────────────────────────────────────────────
PORT=4011
HOST=0.0.0.0
ALLOWED_ORIGINS=https://your-dashboard-domain.com

# ── Tuning ───────────────────────────────────────────────────────
DASHBOARD_REFRESH_COOLDOWN_SECONDS=300

# ── DataForSEO (optional live LLM Mentions console/refresh) ──────
DATAFORSEO_AUTH_HEADER=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
