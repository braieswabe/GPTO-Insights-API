NODE_ENV=production

# ── Database (Neon) ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host:5432/database?sslmode=require
DATABASE_POOL_MAX=10

# ── Auth ─────────────────────────────────────────────────────────
INTERNAL_API_TOKEN=replace-with-a-long-random-secret
CRON_SECRET=replace-with-a-long-random-secret

# ── Server ───────────────────────────────────────────────────────
PORT=4011
HOST=0.0.0.0
ALLOWED_ORIGINS=https://your-dashboard-domain.com

# ── GPTO Suite (signal materialize before gateway prewarm) ─────────
# GPTO_DASHBOARD_BASE_URL=https://your-gpto-dashboard.vercel.app
# GPTO_SIGNAL_MATERIALIZE_TOKEN=same-value-as-on-GPTO
# GPTO_MATERIALIZE_RANGES=7d
# GPTO_SIGNAL_MATERIALIZE_TIMEOUT_MS=110000

# ── Tuning ───────────────────────────────────────────────────────
DASHBOARD_REFRESH_COOLDOWN_SECONDS=300
DASHBOARD_PREWARM_LIMIT=20

# ── DataForSEO (optional live LLM Mentions console/refresh) ──────
DATAFORSEO_AUTH_HEADER=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ── Telemetry daily rollups (optional tuning) ────────────────────
# TELEMETRY_ROLLUP_WITH_DASHBOARD_CRON=1
# TELEMETRY_ROLLUP_CRON_DAYS_BACK=2
# TELEMETRY_ROLLUP_CRON_MAX_SITES=40
# TELEMETRY_ROLLUP_CRON_MAX_RUNS=120
# TELEMETRY_ROLLUP_MAX_SPAN_DAYS=366
# TELEMETRY_ROLLUP_MAX_SITES=80
# TELEMETRY_ROLLUP_MAX_RUNS=500
